color:#fff}.sidefoot{position:absolute;bottom:20px;left:28px;color:#81909e;font-size:12px}.main{padding:28px 34px 60px}.top{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:24px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);font-weight:800}.h1{font-size:30px;font-weight:900;margin:4px 0}.sub{color:var(--muted)}.chip{display:inline-flex;padding:6px 9px;border-radius:999px;font-size:12px;font-weight:800;background:#eef2f6}.green{background:#e7f6ee;color:#0b7545}.blue{background:#e8f0ff;color:#2057ae}.amber{background:#fff3d6;color:#8a5a00}.red{background:#fdecec;color:#9b2929}.purple{background:#eee9ff;color:#5d47ae}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:0 1px 2px rgba(15,23,32,.03)}.metric .k{color:var(--muted);font-size:12px;font-weight:800}.metric .v{font-size:30px;font-weight:900;margin-top:7px}.section{margin-top:22px}.section-title{font-size:18px;font-weight:900;margin:0 0 12px}.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:9px;padding:10px 14px;font-weight:900;cursor:pointer;background:var(--nav);color:#fff}.btn.gold{background:var(--accent);color:#201809}.btn.ghost{background:#fff;color:var(--ink);border:1px solid var(--line)}.btn.greenbtn{background:var(--green)}table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}th,td{text-align:left;padding:12px 13px;border-bottom:1px solid var(--line);font-size:14px}th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);background:#fafbfc}tr:last-child td{border-bottom:0}.cols{display:grid;grid-template-columns:2fr 1fr;gap:18px}.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.pipe{padding:14px;background:#fff;border:1px solid var(--line);border-radius:12px}.pipe strong{display:block;font-size:24px;margin-top:5px}.form{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.form label{font-size:12px;font-weight:800;color:var(--muted)}.form input,.form select{width:100%;margin-top:5px;padding:10px 11px;border:1px solid var(--line);border-radius:8px;background:#fff}.wide{grid-column:1/-1}.hero{padding:22px;background:linear-gradient(135deg,#0f1720,#243746);color:#fff;border-radius:16px}.hero h2{margin:0 0 6px}.hero p{color:#cbd5df}.searchbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:12px}.searchbar input,.searchbar select{padding:10px 11px;border:1px solid var(--line);border-radius:8px;background:#fff}.progress{height:8px;background:#edf1f4;border-radius:99px;overflow:hidden}.progress i{display:block;height:100%;background:var(--accent)}.row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:13px 0;border-top:1px solid var(--line)}.row:first-child{border-top:0}.loginwrap{min-height:100vh;display:grid;place-items:center;background:#0f1720}.login{width:min(420px,92vw);background:#fff;border-radius:18px;padding:28px}.login input{width:100%;padding:12px;border:1px solid var(--line);border-radius:9px;margin:6px 0 14px}
@media(max-width:900px){.shell{grid-template-columns:1fr}.side{height:auto;position:relative}.sidefoot{display:none}.main{padding:20px}.grid{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr}.pipeline{grid-template-columns:1fr 1fr}.form{grid-template-columns:1fr}}
'''

def esc(v): return html.escape(str(v if v is not None else ''))
def status_chip(s):
    cls='green' if s in ('AVAILABLE NOW','OPEN TO OFFERS','READY','QUALIFIED') else 'blue' if s in ('CONTACTED','INTERESTED') else 'amber'
    return f'<span class="chip {cls}">{esc(s)}</span>'

def layout(title, body, active='Dashboard'):
    nav=[('Dashboard','/'),('Workers','/workers'),('Availability','/availability'),('Projects','/projects'),('Crews','/crews'),('Workforce Map','/workforce-map'),('Audit','/audit')]
    links=''.join(f'<a class="{"active" if n==active else ""}" href="{u}">{n}</a>' for n,u in nav)
    return f'''<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>{esc(title)} — Workforce Live</title><style>{CSS}</style></head><body><div class="shell"><aside class="side"><div class="brand">WORKFORCE <span>LIVE</span></div><div class="nav">{links}</div><div class="sidefoot">Euroteams Group · V2<br><a href="/logout">Sign out</a></div></aside><main class="main"><div class="top"><div><div class="eyebrow">Euroteams Group · Live Workforce Network</div><div class="h1">{esc(title)}</div><div class="sub">Real-time cross-border workforce operating system</div></div><span class="chip amber">LIVE REVIEW · V2</span></div>{body}</main></div></body></html>'''

@app.get('/login', response_class=HTMLResponse)
def login_page(error:str=''):
    err='<p style="color:#a33">Incorrect login.</p>' if error else ''
    return HTMLResponse(f'''<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><style>{CSS}</style></head><body><div class="loginwrap"><form class="login" method="post"><div class="brand" s