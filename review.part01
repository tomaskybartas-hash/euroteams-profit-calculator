 solid var(--line)}.pipe strong{display:block;font-size:24px;margin-top:5px}.form{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.form label{font-size:12px;font-weight:700;color:var(--muted)}.form input,.form select{width:100%;margin-top:5px;padding:10px 11px;border:1px solid var(--line);border-radius:8px;background:#fff}.wide{grid-column:1/-1}.hero-action{padding:22px;background:linear-gradient(135deg,#0f1720,#203040);color:#fff;border-radius:16px}.hero-action h2{margin:0 0 6px}.hero-action p{color:#cbd5df;margin:0 0 14px}@media(max-width:900px){.shell{grid-template-columns:1fr}.side{position:relative;height:auto}.grid{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr}.main{padding:20px}.pipeline{grid-template-columns:1fr 1fr}.form{grid-template-columns:1fr}.row{grid-template-columns:1fr 1fr}}
'''

def layout(title, body, active='Dashboard'):
    nav=['Dashboard','Workers','Projects','Crews','Workforce Map','Audit']
    links=''.join(f'<a class="{"active" if n==active else ""}" href="/{n.lower().replace(" ","-") if n!="Dashboard" else ""}">{n}</a>' for n in nav)
    return f'''<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>{html.escape(title)} — Workforce Live</title><style>{CSS}</style></head><body><div class="shell"><aside class="side"><div class="brand">WORKFORCE <span>LIVE</span></div><div class="nav">{links}</div></aside><main class="main"><div class="top"><div><div class="eyebrow">Euroteams Group · Live Workforce Network</div><div class="h1">{html.escape(title)}</div><div class="sub">Real-time cross-border workforce operating system</div></div><div class="demo">REVIEW DEMO · RENDER</div></div>{body}</main></div></body></html>'''

@app.get('/', response_class=HTMLResponse)
def dashboard():
    total=18420; available=5280; ready=2140; active=sum(1 for p in PROJECTS if p['stage']!='DRAFT')
    metrics=[('TOTAL WORKERS',f'{total:,}'),('AVAILABLE NOW',f'{available:,}'),('READY TO DEPLOY',f'{ready:,}'),('ACTIVE PROJECTS',active),('WORKERS NEEDED',sum(p['qty'] for p in PROJECTS)),('MATCHED','491'),('INTERESTED','126'),('READY FOR APPROVAL','53')]
    cards=''.join(f'<div class="card metric"><div class="k">{k}</div><div class="v">{v}</div></div>' for k,v in metrics)
    proj=''.join(f'''<div class="row"><div><strong>{p['name']}</strong><div class="sub">{p['country']} · start {p['start']}</div></div><div><span class="badge {'green' if p['stage']=='RECRUITING' else 'amber'}">{p['stage']}</span></div><div>{p['matched']} matched</div><div>{p['ready']} ready</div><a class="btn ghost" href="/projects/{p['id']}">Open</a></div>''' for p in PROJECTS)
    body=f'''<div class="grid">{cards}</div><div class="cols section"><div><div class="section-title">Active staffing</div><div class="card" style="padding:0">{proj}</div></div><div><div class="section-title">Availability pulse</div><div class="card"><b>Live confirmation freshness</b><p class="sub">Workers confirmed in last 7 days</p><div class="progress"><i style="width:78%"></i></div><p><strong>78%</strong> fresh availability data</p><hr style="border:0;border-top:1px solid var(--line)"><b>Next supply event</b><p class="sub">280 welders predicted to finish projects within 3 weeks.</p></div></div></div><div class="section hero-action"><h2>One Button Recruitment</h2><p>Create a project, press START RECRUITMENT and let the system rank, contact and screen the best-fit workers.</p><a class="btn gold" href="/projects/new">Create Project</a></div>'''
    return layout('Control Center',body)

@app.get('/workers', response_class=HTMLResponse)
def workers():
    rows=''.join(f'''<tr><td><a href="/workers/{w['id']}"><strong>{w['name']}</strong></a><br><span class="sub">{w['country']} · {w['phone']}</span></td><td>{w['trade']}</td><td><span class="badge {'green' if 'AVAILABLE' in w['status'] or 'OPEN' in w['status'] else 'amber'}">{w['status']}</span></td><td>{w['available']}</td><td>€{w['rate']}/h</td><td>{w['confidence']}%</td><td>{'<span class="badge green">READY</span>' if w['ready'] else '<span class="badge amber">VERIFY</span>'}</td></tr>''' for w in WORKERS)
    body=f'''<div style="display:flex;justify-content:space-between;margin-bottom:12px"><div class="sub">Structured profiles, availability, documents and deployment readiness.</div><a class="btn" href="/workers/new">+ Add Worker</a></div><table><thead><tr><th>Worker</th><th>Trade</th><th>Availability</th><th>From</th><th>Rate</th><th>Confidence</th><th>Passport</th></tr></thead><tbody>{rows}</tbody></table>'''
    return layout('Workers',body,'Workers')

@app.get('/workers/{wid}', response_class=HTMLResponse)
def worker_detail(wid:int):
    w=next((x for x in WORKERS if x['id']==wid),None)
    if not w:return HTMLResponse('Not found',404)
    body=f'''<div class="cols"><div class="card"><h2>{w['name']}</h2><p class="sub">{w['country']} · {w['trade']}</p><div class="grid" style="grid-template-columns:repeat(2,1fr)"><div><b>Availability</b><p><span class="badge green">{w['status']}</span></p></div><div><b>Availability confidence</b><p>{w['confidence']}%</p></div><div><b>Expected rate</b><p>€{w['rate']} net/h</p></div><div><b>Rotation</b><p>{w['rotation']}</p></div><div><b>Language</b><p>{w['language']}</p></div><div><b>Certificate</b><p>{w['cert']}</p></div></div></div><div class="card"><h3>Digital Worker Passport</h3><p>Identity <span class="badge green">VERIFIED</span></p><p>Qualification <span class="badge green">VERIFIED</span></p><p>Certificates <span class="badge green">VALID</span></p><p>Availability <span class="badge green">FRESH</span></p><p>Ready to Deploy <span class="badge {'green' if w['ready'] else 'amber'}">{'YES' if w['ready'] else 'PENDING'}</span></p></div></div><div class="section card"><h3>AI Match profile</h3><div class="pipeline"><div class="pipe">Fit<strong>{w['fit']}%</strong></div><div class="pipe">Interest<strong>{w['interest']}%</strong></div><div class="pipe">Arrival<strong>{w['arr